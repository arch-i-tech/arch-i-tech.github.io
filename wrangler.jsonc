// Cloudflare Workers config for the temporary `develop` preview.
// Serves the static Astro build in ./dist as plain assets, with no server code.
// Having this file stops `wrangler deploy` from auto-running `astro add cloudflare`,
// which would turn the site into an SSR app. GitHub Pages ignores this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arch-i-tech-github-io",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
