# Normalize line endings to LF for all text files, regardless of OS settings
* text=auto eol=lf

# Binary files: never touch line endings or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mp4  binary
*.webm binary
