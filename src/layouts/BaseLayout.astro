---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { getImage } from 'astro:assets';
import { getFeaturedProjects } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Keep the page out of search engines (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, image, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Architecture, Landscape & Visualization`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pages without their own image share the first featured project's cover in link previews.
let shareImage = image;
if (!shareImage) {
  const [lead] = await getFeaturedProjects(1);
  if (lead) shareImage = (await getImage({ src: lead.data.cover, width: 1200, height: 630, format: 'jpg' })).src;
}
const ogImage = shareImage ? new URL(shareImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f2ee" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
