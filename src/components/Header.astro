---
const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/#services', label: 'Services' },
  { href: '/about/', label: 'Studio' },
];
const isCurrent = (href: string) => {
  const base = href.split('#')[0];
  return base !== '/' && !href.includes('#') && path.startsWith(base);
};
---
<header class="site-header container">
  <a href="/" class="logo">ARCH-I-TECH <span>LTD</span></a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href="/about/#contact" class="contact">Contact</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
  }
  .logo {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }
  .logo span {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  nav a { padding: 0.75rem 0; }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }
  .contact { color: var(--accent); }
</style>
