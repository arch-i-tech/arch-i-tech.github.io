---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/#services', label: 'Services' },
  { href: '/about/', label: 'About', accent: true },
];
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---
<header class="site-header container">
  <a href="/" class="logo">
    <Image src={logo} alt="Arch-I-Tech Ltd — home" width={624} densities={[1, 2]} loading="eager" />
  </a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={l.href} class:list={{ accent: l.accent }} aria-current={isCurrent(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.75rem;
  }
  .logo { display: flex; align-items: center; padding: 0.25rem 0; }
  .logo img { width: 19.5rem; max-width: 100%; height: auto; }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  nav a { padding: 0.75rem 0; }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }
  .accent { color: var(--accent); }
  @media (max-width: 640px) {
    .logo img { width: 15rem; }
    nav { gap: 0.25rem 1.75rem; }
  }
</style>
