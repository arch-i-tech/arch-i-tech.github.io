---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <div class="top">
      <div class="brand">
        <span class="logo">ARCH-I-TECH</span>
        <p>{site.tagline}</p>
      </div>
      <div class="cols">
        <div class="col">
          <span class="label">Studio</span>
          <a href="/projects/">Projects</a>
          <a href="/about/#services">Services</a>
          <a href="/about/">About</a>
        </div>
        <div class="col">
          <span class="label">Contact</span>
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          {site.phone && <span>{site.phone}</span>}
          {site.facebook && <a href={site.facebook} rel="noopener">Facebook</a>}
          <a href="/about/#contact">Send a message</a>
        </div>
      </div>
    </div>
    <div class="bottom">© {year} {site.legalName}. All rights reserved.</div>
  </div>
</footer>

<style>
  .site-footer { background: var(--dark); color: var(--dark-ink); }
  .site-footer a { color: var(--dark-ink); }
  .site-footer a:hover { color: #fff; text-decoration: underline; }
  .inner { padding-block: 4rem 2.5rem; display: flex; flex-direction: column; gap: 3rem; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2.5rem; }
  .brand { max-width: 22rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .brand p { margin: 0; color: var(--dark-muted); font-size: 0.9375rem; }
  .logo { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: 0.18em; }
  .cols { display: flex; flex-wrap: wrap; gap: 3rem 5rem; font-size: 0.9375rem; }
  .col { display: flex; flex-direction: column; gap: 0.25rem; }
  .col a, .col span:not(.label) { padding: 0.375rem 0; }
  .label { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dark-muted); margin-bottom: 0.5rem; }
  .bottom { padding-top: 1.5rem; border-top: 1px solid #3a3835; font-size: 0.8125rem; color: var(--dark-muted); }
</style>
