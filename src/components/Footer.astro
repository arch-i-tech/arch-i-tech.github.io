---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <span class="logo">ARCH-I-TECH</span>
    <span class="copy">© {year} {site.legalName}. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--dark); color: var(--dark-ink); }
  .inner {
    padding-block: 2.5rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem;
    font-size: 0.875rem;
  }
  .logo { font-family: var(--font-display); font-weight: 600; letter-spacing: 0.18em; }
  .copy { color: var(--dark-muted); }
</style>
