---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import danPortrait from '../assets/team-dan-markov.jpg';
import UpworkIcon from '../assets/icons/upwork.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';

// TODO (phase 2): move team + services into CMS-editable data.
// Missing links are left out, not shown as placeholders. Upwork always comes before LinkedIn.
interface Member {
  name: string;
  role: string;
  bio: string;
  photo?: ImageMetadata;
  upwork?: string;
  linkedin?: string;
}
const team: Member[] = [
  {
    name: 'Irina Rizova',
    role: 'Architecture',
    bio: 'Educated at Pratt Institute, New York, Irina leads architecture projects globally, specializing in residential, commercial and hospitality design.',
    linkedin: 'https://www.linkedin.com/in/irina-rizova-leed-ap-97082714/',
  },
  {
    name: 'Borislav Stoynev',
    role: 'Site Planning & Master Planning',
    bio: 'Borislav specializes in site planning and master planning for resorts, F&B, mixed-use and industrial developments — orchestrating buildings, circulation and outdoor space.',
    upwork: 'https://www.upwork.com/freelancers/borislavstoynev',
  },
  {
    name: 'Dan Markov',
    role: 'Design and Development',
    bio: 'Dan brings advanced 3D design, modeling and visualization expertise, producing photorealistic imagery that communicates design intent and elevates client presentations.',
    photo: danPortrait,
    linkedin: 'https://www.linkedin.com/in/danidan8/',
  },
];

const services = [
  {
    title: 'Architecture & Engineering',
    items: [
      'Feasibility studies and site analysis',
      'Concept design and photoreal visualization',
      'Technical and detailed design, specifications, bills of quantities',
      'Coordination with contractors and consultants',
      'As-built drawings and documentation',
    ],
  },
  {
    title: 'Planning & Landscape',
    items: [
      'Master planning of resorts, hospitality and urban districts',
      'Residential communities and mixed-use developments',
      'Parks, gardens and recreational attractions',
      'Historical restoration and adaptive reuse',
    ],
  },
  {
    title: '3D Animation & VFX',
    items: [
      'Photorealistic 3D animation',
      'Projection mapping and immersive media',
      'VFX for film, commercials and creative productions',
    ],
  },
  {
    title: 'Coordination & Innovation',
    items: [
      'Tenant coordination and fit-out supervision',
      'Marketing plans and presentation support',
      'Design for startups, marine tech and autonomous farms',
      'AI-assisted and generative design workflows',
    ],
  },
];

const initials = (name: string) => name.split(' ').map((n) => n[0]).join('');
---
<BaseLayout title="About" description="About Arch-I-Tech: our team and services.">
  <section class="container intro">
    <h1 class="display">The studio</h1>
    <div class="intro-text">
      <p class="lede">
        An international design studio specializing in architecture, landscape architecture and
        high-end 3D visualization.
      </p>
      <p>
        We transform ideas into functional, visually striking spaces across residential, commercial,
        hospitality, mixed-use and industrial projects worldwide. We integrate architectural
        expertise, landscape strategy and advanced 3D visualization to support projects from concept
        to presentation — adapting to diverse markets, scales and design challenges while keeping a
        consistently high standard.
      </p>
      {(site.upwork || site.linkedin) && (
        <div class="profiles">
          <span class="eyebrow">Find us on</span>
          {site.upwork && (
            <a href={site.upwork} class="profile-btn" rel="noopener" target="_blank">
              <UpworkIcon class="icon" aria-hidden="true" />
              Hire us on Upwork<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          )}
          {site.linkedin && (
            <a href={site.linkedin} class="profile-btn" rel="noopener" target="_blank">
              <LinkedInIcon class="icon" aria-hidden="true" />
              LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="container team" aria-labelledby="team">
    <div class="section-head"><h2 id="team" class="eyebrow">Our team</h2></div>
    <div class="team-grid">
      {team.map((m) => (
        <article>
          {m.photo ? (
            <Image src={m.photo} alt={`Portrait of ${m.name}`} widths={[320, 480, 720]} sizes="(max-width: 700px) 100vw, 33vw" class="portrait" />
          ) : (
            <div class="portrait placeholder" role="img" aria-label={`Portrait of ${m.name} (photo coming soon)`}>{initials(m.name)}</div>
          )}
          <h3>{m.name}</h3>
          <span class="eyebrow role">{m.role}</span>
          <p>{m.bio}</p>
          {(m.upwork || m.linkedin) && (
            <div class="member-links">
              {m.upwork && (
                <a href={m.upwork} rel="noopener" target="_blank" aria-label={`Upwork: ${m.name} (opens in a new tab)`}><UpworkIcon class="icon" aria-hidden="true" /> Upwork</a>
              )}
              {m.linkedin && (
                <a href={m.linkedin} rel="noopener" target="_blank" aria-label={`LinkedIn: ${m.name} (opens in a new tab)`}><LinkedInIcon class="icon" aria-hidden="true" /> LinkedIn</a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="services" class="services" aria-labelledby="services-h">
    <div class="container services-inner">
      <div class="services-head">
        <h2 id="services-h">Services</h2>
        <p>Comprehensive support across every stage of a project.</p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <div class="service">
            <h3>{s.title}</h3>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: 4.5rem 5rem; display: flex; flex-wrap: wrap; gap: 2.5rem 6rem; }
  .intro .display { flex: 1 1 24rem; }
  .intro-text { flex: 1.4 1 30rem; display: flex; flex-direction: column; gap: 1.25rem; font-size: 1.0625rem; line-height: 1.75; color: var(--ink-2); }
  .intro-text p { margin: 0; }
  .intro-text .lede { color: var(--ink); }
  .profiles { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; padding-top: 0.5rem; }
  .profiles .eyebrow { width: 100%; color: var(--label); }
  .profile-btn {
    display: inline-flex; align-items: center; gap: 0.625rem;
    min-height: 3rem; padding: 0 1.25rem;
    border: 1px solid var(--ink); color: var(--ink);
    font-size: 0.9375rem; font-weight: 600; line-height: 1;
  }
  .profile-btn:hover { border-color: var(--accent); color: var(--accent); }
  .profiles :global(.icon) { width: 1.125rem; height: 1.125rem; flex: none; }
  .member-links :global(.icon) { width: 1rem; height: 1rem; }

  .team { padding-bottom: 6rem; }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 3rem 2rem; }
  .team article { display: flex; flex-direction: column; gap: 1rem; }
  .portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--surface); }
  .placeholder { display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 3rem; font-weight: 300; color: var(--placeholder-ink); }
  .member-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .member-links a {
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 2.75rem; padding: 0 1rem;
    border: 1px solid var(--outline); font-size: 0.875rem; font-weight: 600;
  }
  .member-links a:hover { border-color: var(--accent); color: var(--accent); }
  .team h3 { font-size: 1.375rem; font-weight: 500; }
  .role { color: var(--accent); }
  .team p { margin: 0; font-size: 0.9375rem; color: var(--text-2); }

  .services { background: var(--bg-alt); padding-block: 6rem; }
  .services-inner { display: flex; flex-wrap: wrap; gap: 3rem 6rem; }
  .services-head { flex: 1 1 18rem; display: flex; flex-direction: column; gap: 1rem; }
  .services-head h2 { font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 300; letter-spacing: -0.02em; }
  .services-head p { margin: 0; color: var(--text-2); }
  .services-grid { flex: 2 1 32rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 2.5rem 3rem; }
  .service { display: flex; flex-direction: column; gap: 0.875rem; padding-top: 1.25rem; border-top: 1px solid var(--ink); }
  .service h3 { font-size: 1.25rem; font-weight: 500; }
  .service ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.375rem; font-size: 0.9375rem; line-height: 1.55; color: var(--text-2); }

</style>
