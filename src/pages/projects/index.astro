---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { CATEGORIES } from '../../content.config';

const projects = await getProjects();
// Only show filters that at least one project uses.
const used = CATEGORIES.filter((c) => projects.some((p) => p.data.categories.includes(c)));
const filters = ['All', ...used];
---
<BaseLayout title="Projects" description="Master plans, buildings, landscapes and interiors by Arch-I-Tech.">
  <section class="container head">
    <h1 class="display">Projects</h1>
    <p>
      Master plans, buildings, landscapes and interiors — designed and visualized by our studio for
      clients across five continents.
    </p>
  </section>

  <section class="container list">
    <div class="filters" role="group" aria-label="Filter projects by discipline">
      {filters.map((f, i) => (
        <button type="button" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>
      ))}
      <span class="count" aria-live="polite" data-count>{projects.length} projects</span>
    </div>

    <div class="grid-projects" data-grid>
      {projects.map((p, i) => <ProjectCard project={p} eager={i < 3} />)}
    </div>
    <div class="more" data-more-wrap hidden>
      <button type="button" class="btn btn--ghost" data-more>Load more projects</button>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: without JS every project stays visible.
  const PAGE = 24;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-grid] [data-categories]'));
  const count = document.querySelector<HTMLElement>('[data-count]');
  const moreWrap = document.querySelector<HTMLElement>('[data-more-wrap]');
  const more = document.querySelector<HTMLButtonElement>('[data-more]');
  let filter = 'All';
  let limit = PAGE;

  function apply() {
    const matching = cards.filter((card) => filter === 'All' || (card.dataset.categories ?? '').split('|').includes(filter));
    cards.forEach((card) => (card.hidden = true));
    matching.slice(0, limit).forEach((card) => (card.hidden = false));
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    if (count) count.textContent = `${matching.length} ${matching.length === 1 ? 'project' : 'projects'}`;
    if (moreWrap) moreWrap.hidden = matching.length <= limit;
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      filter = b.dataset.filter ?? 'All';
      limit = PAGE;
      apply();
    }),
  );
  more?.addEventListener('click', () => {
    const firstNew = cards.filter((c) => c.hidden === true && (filter === 'All' || (c.dataset.categories ?? '').split('|').includes(filter)))[0];
    limit += PAGE;
    apply();
    firstNew?.focus();
  });
  apply();
</script>

<style>
  .head { padding-block: 4.5rem 2.5rem; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem 4rem; }
  .head p { margin: 0; max-width: 30rem; color: var(--text-2); line-height: 1.65; }
  .list { padding-bottom: 6rem; }
  .filters {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    padding-block: 1.25rem; margin-bottom: 2.5rem;
    border-block: 1px solid var(--line);
  }
  .filters button {
    min-height: 2.75rem; padding: 0 1.25rem;
    border: 1px solid var(--outline); background: transparent; color: var(--ink);
    font: 500 0.875rem var(--font-body); cursor: pointer;
  }
  .filters button:hover { border-color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .more { display: flex; justify-content: center; padding-top: 4rem; }
  .count { margin-left: auto; align-self: center; font-size: 0.875rem; color: var(--muted); }
</style>
